# Application
APP_NAME=TraceMatrix
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://tracematrix:tracematrix@localhost:5432/tracematrix

# Redis (optional; without it, jobs run in-process)
REDIS_URL=redis://localhost:6379/0

# Authentication bootstrap (used only by `python -m app.cli bootstrap`)
BOOTSTRAP_ADMIN_EMAIL=analyst@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Ethereum
# JSON-RPC endpoint. Leave empty to keep the integration in "Not configured".
ETH_RPC_URL=
# Optional Etherscan-compatible explorer for historical address activity.
ETHERSCAN_API_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=

# GitHub (optional; unauthenticated public search is rate-limited)
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# OSINT feed SSRF controls (comma-separated host allowlist; empty = block all remote feeds until configured)
OSINT_FEED_ALLOWLIST=

# Analysis / ingestion bounds
MAX_INGEST_TRANSACTIONS=200
MAX_GRAPH_NODES=250
MAX_GRAPH_DEPTH=3
JOB_TIMEOUT_SECONDS=180

# Demo fixtures (never treat as live chain data)
ALLOW_FIXTURE_PROVIDER=false
